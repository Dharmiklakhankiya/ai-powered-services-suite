{
  "name": "ai-powered-services-suite",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @suite/frontend --filter @suite/booking-service --filter @suite/ai-service --filter @suite/resume-service run dev",
    "dev:frontend": "pnpm --filter @suite/frontend run dev",
    "dev:booking": "pnpm --filter @suite/booking-service run dev",
    "dev:ai": "pnpm --filter @suite/ai-service run dev",
    "dev:resume": "pnpm --filter @suite/resume-service run dev",
    "dev:services": "pnpm -r --parallel --filter @suite/booking-service --filter @suite/ai-service --filter @suite/resume-service run dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm -r --parallel --filter @suite/frontend --filter @suite/booking-service --filter @suite/ai-service --filter @suite/resume-service run start"
  },
  "packageManager": "pnpm@10.33.0"
}